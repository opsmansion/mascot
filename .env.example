# Copy to .env on the server. All values are optional; these are the defaults.
# Port on 127.0.0.1 that Nginx proxies to (Studio uses 3100 and 8100; 3200 is taken). Check a port is free with: sudo ss -ltnp | grep :3300
MASCOTS_PORT=3300
# Maker zips each visitor may download per minute.
MASCOTS_MAKER_RATE_PER_MINUTE=6
# Icon sets drawn at once, and how many more may wait before visitors are asked to retry.
MASCOTS_MAX_CONCURRENT=2
MASCOTS_MAX_QUEUE=20
